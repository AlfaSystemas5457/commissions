<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="seq_commissions_uid" model="ir.sequence">
        <field name="name">Comisiones</field>
        <field name="code">commissions.commissions</field>
        <field name="prefix">CO-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="commissions_commissions_view_form" model="ir.ui.view">
        <field name="name">commissions.commissions.form</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <form string="Comisión" duplicate="0" delete="0">
                <header>
                    <button string="Marcar como pagado"
                        name="handle_paid"
                        invisible="paid"
                        type="object"
                        class="oe_highlight"
                        groups="commissions.group_commissions_access_all" />
                </header>

                <sheet>
                    <div class="oe_title">
                        <field name="uid" invisible="not uid" />
                        <h1>
                            <field name="seller" readonly="1" />
                        </h1>

                        <h3 class="o_stat_value d-flex gap-1 text-center">
                            <span>Comisión</span>
                            <span>$</span>
                            <field readonly="paid" name="commission" />
                        </h3>
                    </div>
                    <hr />
                    <group>
                        <group>
                            <field name="plan_ids" widget="many2many_tags" readonly="1" />
                            <field name="sale_id" readonly="1" invisible="not sale_id" />
                            <field name="invoice_id" readonly="1" invisible="not invoice_id" />
                        </group>
                        <group>
                            <field name="date" readonly="1" />
                            <field name="paid" readonly="1" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="commissions_commissions_view_list" model="ir.ui.view">
        <field name="name">commissions.commissions.view.list</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <list string="Comisiones" create="0" delete="0">
                <field name="uid" width="100" decoration-bf="1" />
                <field name="seller" readonly="1" />
                <field name="plan_ids" widget="many2many_tags" readonly="1" optional="show" />
                <field name="sale_id" readonly="1" />
                <field name="invoice_id" readonly="1" />
                <field name="date" readonly="1" optional="show" />
                <field name="paid" readonly="1" optional="show" />
                <field name="commission" readonly="1" sum="Total Comisión" />
            </list>
        </field>
    </record>

    <record id="commissions_commissions_view_kanban" model="ir.ui.view">
        <field name="name">commissions.commissions.view.kanban</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <kanban string="Comisiones">
                <field name="seller" />
                <field name="commission" />
                <field name="paid" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <strong>
                                <field name="seller" />
                            </strong>
                            <div>
                                <field name="commission" widget="monetary" />
                            </div>
                            <div class="o_kanban_footer">
                                <field name="paid" widget="boolean" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="commissions_commissions_view_graph" model="ir.ui.view">
        <field name="name">commissions.commissions.view.graph</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <graph string="Comisiones por Vendedor" type="pie">
                <field name="seller" type="dimension" />
                <field name="commission" type="measure" />
            </graph>
        </field>
    </record>


    <record id="commissions_commissions_view_search" model="ir.ui.view">
        <field name="name">commissions.commissions.view.search</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <search string="Buscar comisiones">
                <field name="seller" />
                <field name="plan_ids" />
                <field name="sale_id" />
                <field name="invoice_id" />
                <field name="paid" />
                <field name="date" />

                <filter name="filter_with_paid"
                    string="No pagadas"
                    domain="[('paid', '=', False)]"
                    context="{'default_paid': False}"
                    help="Mostrar solo comisiones no pagadas" />

                <filter name="filter_with_sale"
                    string="Vendidas"
                    domain="[('sale_id', '!=', False)]"
                    context="{}"
                    help="Mostrar comisiones con venta" />

                <filter name="filter_with_invoice"
                    string="Facturadas"
                    domain="[('invoice_id', '!=', False)]"
                    context="{}"
                    help="Mostrar comisiones con factura" />

                <group expand="1" string="Agrupar por">
                    <filter string="Vendedor" name="group_by_seller"
                        context="{'group_by': 'seller'}" />
                    <filter string="Plan" name="group_by_plan" context="{'group_by': 'plan_ids'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_handle_paid" model="ir.actions.server">
        <field name="name">Marcar como pagada</field>
        <field name="model_id" ref="model_commissions_commissions" />
        <field name="binding_model_id" ref="model_commissions_commissions" />
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
            action = records.handle_paid()
        </field>
    </record>

    <record id="commissions_commissions_action" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">commissions.commissions</field>
        <field name="context">{'search_default_filter_with_paid': 1}</field>
        <field name="view_mode">list,form,kanban,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aqui apareceran las comisiones.
            </p>
        </field>
    </record>

    <menuitem
        id="commissions_commissions_menu"
        name="Comisiones"
        action="commissions.commissions_commissions_action"
        parent="commissions.commissions_menu"
        sequence="10" />
</odoo>