<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="seq_commissions_uid" model="ir.sequence">
        <field name="name">Comisiones</field>
        <field name="code">commissions.commissions</field>
        <field name="prefix">CO-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="commissions_commissions_view_form" model="ir.ui.view">
        <field name="name">commissions.commissions.form</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <form string="Comisión" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <field name="uid" invisible="not uid" />
                        <h1>
                            <field name="seller" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_ids" widget="many2many_tags" readonly="1" />
                            <field name="sale_id" readonly="1" invisible="not sale_id" />
                            <field name="invoice_id" readonly="1" invisible="not invoice_id" />
                        </group>
                        <group>
                            <field name="date" readonly="1" />
                            <field name="commission" widget="monetary" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="commissions_commissions_view_list" model="ir.ui.view">
        <field name="name">commissions.commissions.view.list</field>
        <field name="model">commissions.commissions</field>
        <field name="arch" type="xml">
            <list string="Comisiones" create="0" delete="0">
                <field name="uid" readonly="1" />
                <field name="seller" readonly="1" />
                <field name="plan_ids" widget="many2many_tags" readonly="1" />
                <field name="sale_id" readonly="1" />
                <field name="invoice_id" readonly="1" />
                <field name="date" readonly="1" />
                <field name="commission" readonly="1" sum="Total Comisión" />
            </list>
        </field>
    </record>

    <record id="commissions_commissions_action" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">commissions.commissions</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aqui apareceran las comisiones.
            </p>
        </field>
    </record>

    <menuitem
        id="commissions_commissions_menu"
        name="Comisiones"
        action="commissions.commissions_commissions_action"
        parent="commissions.commissions_menu"
        sequence="10" />
</odoo>