<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="commissions_plans_view_form" model="ir.ui.view">
        <field name="name">commissions.plans.view.form</field>
        <field name="model">commissions.plans</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button string="Aprobar"
                        name="handle_approved"
                        type="object"
                        invisible="state != 'draft'"
                        class="oe_highlight" />
                    <button string="Hecho"
                        name="handle_done"
                        type="object"
                        invisible="state != 'approved'"
                        class="oe_highlight" />
                    <button string="Cancelar"
                        name="handle_cancel"
                        type="object"
                        invisible="state != 'approved'"
                        class="btn-secondary" />
                    <button string="Borrador"
                        name="handle_draft"
                        type="object"
                        class="btn-secondary" />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <div class="oe_title">
                            <label for="name" string="Plan de comisión" />
                            <h1>
                                <field name="name" readonly="state != 'draft'" />
                            </h1>
                        </div>
                    </group>
                    <group>
                        <!-- <group>
                            <label for="type_commission" string="Según" />
                            <div>
                                <field name="type_commission" class="oe_inline"
                                    readonly="state != 'draft'" /> por <field name="type_sellers"
                                    class="oe_inline" readonly="state != 'draft'" />
                            </div>
                        </group> -->
                        <group>
                            <label for="date_from" string="Periodo efectivo" />
                            <div>
                                <field name="date_from" class="oe_inline"
                                    readonly="state != 'draft'"
                                    force_save="1" />
                                <i class="oi oi-fw oi-arrow-right" />
                                <field name="date_to" class="oe_inline" readonly="state != 'draft'"
                                    force_save="1" />
                            </div>
                            <!-- <field name="Freq_target" readonly="state != 'draft'" /> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Logros">
                            <field name="achievement_ids"
                                readonly="state != 'draft'">
                                <list editable="bottom">
                                    <control>
                                        <create string="Agregar logros" />
                                    </control>
                                    <field name="achievements_type" />
                                    <field name="product_id" />
                                    <field name="product_category_id" />
                                    <field name="rate" widget="percentage" />
                                </list>
                            </field>
                        </page>
                        <page string="Vendedores">
                            <field name="sellers_ids"
                                readonly="state != 'draft'">
                                <list editable="bottom">
                                    <control>
                                        <create string="Agregar vendedor" />
                                    </control>
                                    <field name="seller" />
                                    <field name="date_from" />
                                    <field name="date_to" />
                                    <field name="other_plans" widget="many2many_tags"
                                        readonly="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="commissions_plans_view_list" model="ir.ui.view">
        <field name="name">commissions.plans.view.list</field>
        <field name="model">commissions.plans</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <!-- <field name="type_commission" /> -->
                <!-- <field name="Freq_target" /> -->
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="commissions_plans_action" model="ir.actions.act_window">
        <field name="name">Planes de comisión</field>
        <field name="res_model">commissions.plans</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aqui puedes gestionar tus planes de comisiones.
            </p>
        </field>
    </record>

    <menuitem
        id="commissions_plans_menu"
        name="Planes de comisión"
        action="commissions.commissions_plans_action"
        parent="commissions.commissions_menu"
        sequence="20" />
</odoo>