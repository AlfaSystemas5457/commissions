<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_order_form_readonly_user_id_for_assigned_group" model="ir.ui.view">
        <field name="name">sale.order.form.user_id.readonly.assigned</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" readonly="1"
                    groups="commissions.group_commissions_access_assigned" />
                <field name="user_id" readonly="0"
                    groups="commissions.group_commissions_access_all" />
            </xpath>
        </field>
    </record>
</odoo>